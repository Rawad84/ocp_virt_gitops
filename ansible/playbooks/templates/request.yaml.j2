{# Rendered request file — schema must match charts/vm-request's expectations
   exactly (see requests/group-1/request.yaml for the reference example). #}
cluster: {{ cluster }}
cluster_name: {{ cluster_name }}
namespace: {{ namespace }}
networks:
{% for net in render_networks %}
  - name: {{ net.name }}
    vlanID: {{ net.vlanID }}
{% if net.prefixLength is defined and net.prefixLength %}
    prefixLength: {{ net.prefixLength }}
{% endif %}
{% if net.gateway is defined and net.gateway %}
    gateway: {{ net.gateway }}
{% endif %}
{% endfor %}
sshKey: "{{ ssh_key }}"
vms:
{% for vm in render_vms %}
  - name: {{ vm.name }}
{% if vm.size is defined and vm.size %}
    size: {{ vm.size }}
{% endif %}
{% if vm.ip is defined and vm.ip %}
    ip: {{ vm.ip }}
{% endif %}
{# TEMPORARY: skip_second_nic passthrough for a one-off live EE test against
   this cluster's missing vlan-1415 OVN bridge mapping - to be reverted
   alongside the matching chart change once that test is done. #}
{% if vm.skip_second_nic is defined and vm.skip_second_nic %}
    skip_second_nic: true
{% else %}
    network: {{ vm.network }}
{% endif %}
{% endfor %}
